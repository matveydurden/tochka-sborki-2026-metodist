# Copy to .env and fill locally. Never put this key in frontend files.
LLM_API_KEY=
LLM_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
CLOUDRU_MODEL=GigaChat/GigaChat-3-Pro
# Direct Cloud.ru is also supported; see README.

# Для публичного демо: общий пароль команды (от 16 символов), вне Git
METODIST_PASSWORD=
# Запуск: --host 0.0.0.0 --port 8000 --public-origin https://адрес-команды
